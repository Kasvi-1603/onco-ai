# Simulated-data mode — no file upload or OCR required.
# Demo flow: POST /api/demo → POST /api/analyze/{session_id}

# Groq (preferred when set): backend uses Groq first, then Ollama, then template fallbacks.
# Add your key here — do NOT start the server with GROQ_API_KEY="" in the shell.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
DATABASE_URL=./oncopilot.db
NEXT_PUBLIC_API_URL=http://localhost:8000
